generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  bio           String?
  banned        Boolean   @default(false)
  showNsfw      Boolean   @default(false)
  promotionalEmails Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  comments      Comment[]
  postVotes     PostVote[]
  commentVotes  CommentVote[]
  communities   Community[]
  subscriptions Subscription[]
  notifications Notification[]
  savedPosts    SavedPost[]
  mutes         Mute[]    @relation("UserMutes")
  mutedBy       Mute[]    @relation("UserMutedBy")
  @@index([username])
  @@map("users")
}
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@map("accounts")
}
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sessions")
}
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
  @@map("verification_tokens")
}
model Community {
  id            String         @id @default(cuid())
  name          String         @unique
  title         String
  description   String
  rules         String?
  nsfw          Boolean        @default(false)
  postFormat    String         @default("any")
  creatorId     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  creator       User           @relation(fields: [creatorId], references: [id])
  posts         Post[]
  subscriptions Subscription[]
  @@index([name])
  @@map("communities")
}
model Post {
  id               String      @id @default(cuid())
  title            String
  body             String?
  url              String?
  thumbnail        String?
  score            Int         @default(0)
  commentCount     Int         @default(0)
  nsfw             Boolean     @default(false)
  moderationStatus String      @default("approved")
  moderationReason String?
  communityId      String
  authorId         String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  community        Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author           User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments         Comment[]
  votes            PostVote[]
  savedBy          SavedPost[]
  @@index([authorId])
  @@index([communityId, createdAt])
  @@index([communityId, score])
  @@index([createdAt])
  @@map("posts")
}
model Comment {
  id               String        @id @default(cuid())
  body             String
  imageUrl         String?
  score            Int           @default(0)
  moderationStatus String        @default("approved")
  moderationReason String?
  postId           String
  authorId         String
  parentId      